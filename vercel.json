{
  "version": 2,
  "functions": {
    "api/index.js": { "maxDuration": 60, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/admin.php", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/index.php", "destination": "/api/index.js" }
  ]
}
